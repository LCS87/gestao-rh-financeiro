# Configurações de ambiente (exemplo)
# Copie este arquivo para .env e ajuste os valores antes de rodar a instância local.

DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestao_rh_financeiro

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# JWT (mínimo 32 caracteres)
JWT_SECRET=your-very-secure-secret

# Jasypt (utilizado para encriptar valores sensíveis)
JASYPT_PASSWORD=your-jasypt-password

# Spring profiles
SPRING_PROFILES_ACTIVE=dev

# CORS (lista de origens separadas por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:3007,http://localhost:3000

# Seed de usuarios (em producao SEED_DEFAULT_PASSWORD e obrigatoria)
SEED_DEFAULT_PASSWORD=
SEED_RH_PASSWORD=
SEED_FINANCEIRO_PASSWORD=
